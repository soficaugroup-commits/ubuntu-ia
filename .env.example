# Copier vers .env — ne jamais committer de clés réelles.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (préfixe NEXT_PUBLIC_ uniquement pour les clés publiables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En production Netlify : https://ubuntu-ia.com
# Renseigner les mêmes clés (sauf chemins locaux) dans
# Site configuration → Environment variables.

# Invitations — Resend (côté serveur uniquement)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ubuntu IA <noreply@ubuntu-grp.com>

# LLM — côté serveur uniquement. Préférer une clé OpenRouter sk-or-v1-
# En prod, si cette variable est absente, Ubuntu IA utilise la passerelle
# IA de Netlify (OPENROUTER_BASE_URL / OPENAI_BASE_URL) au lieu de refuser.
OPENROUTER_API_KEY=

# Modèle d'embedding figé dans backend/ingestion/config.py
# EMBEDDING_MODEL=openai/text-embedding-3-small (1536 dimensions)
# Conversation — modèle figé
# CHAT_MODEL=openai/gpt-6-astra
# Lecture des images, infographies et PDF scannés
# VISION_MODEL=openai/gpt-4o-mini
# Création d'image (outil compositeur)
# IMAGE_MODEL=openai/gpt-image-2

# Mode vocal — OpenRouter uniquement (openai/gpt-audio, pas de clé OpenAI).
# REALTIME_MODEL=openai/gpt-audio-mini
# REALTIME_VOICE=alloy
# VOICE_STT_MODEL=openai/whisper-1
